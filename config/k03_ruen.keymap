#include "keys_ru.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        enc_vol: enc_vol {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ENC_VOL";
            #sensor-binding-cells = <0>;
            bindings = <&kp C_VOL_UP>, <&kp C_VOL_DN>;
        };
    };

    combos {
        compatible = "zmk,combos";

        cmben {
            bindings = <&layer_en>;
            key-positions = <15 16>;
            layers = <1>;
        };

        cmbru {
            bindings = <&layer_ru>;
            key-positions = <15 16>;
            layers = <0>;
        };
    };

    macros {
        to_ru: to_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LC(N2))>;
            label = "TO_RU";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        to_en: to_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LC(N1))>;
            label = "TO_EN";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        layer_en: layer_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &to_en>;
            label = "LAYER_EN";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        layer_ru: layer_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 1 &to_ru>;
            label = "LAYER_RU";
            tap-ms = <30>;
            wait-ms = <0>;
        };

        en: en {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&to_en>,
                <&macro_press>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&to_ru>;

            label = "EN";
            wait-ms = <0>;
            tap-ms = <30>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        en {
            bindings = <
&kp ESC     &kp N1  &kp N2    &kp N3    &kp N4     &kp N5                           &kp N6  &kp N7      &kp N8     &kp N9    &kp N0             &kp BACKSPACE
&kp TAB     &kp Q   &kp W     &kp E     &kp R      &kp T                            &kp Y   &kp U       &kp I      &kp O     &kp P              &kp LEFT_BRACKET
&kp LSHIFT  &kp A   &kp S     &kp D     &kp F      &kp G                            &kp H   &kp J       &kp K      &kp L     &kp SEMI           &kp SQT
&kp LCTRL   &kp Z   &kp X     &kp C     &kp V      &kp B   &kp C_PP     &kp C_MUTE  &kp N   &kp M       &kp COMMA  &kp DOT   &kp RIGHT_BRACKET  &kp GRAVE
                    &kp LGUI  &kp LALT  &kp LSHFT  &mo 2   &kp SPACE    &kp ENTER   &mo 3   &kp RSHIFT  &kp FSLH   &kp BSLH
            >;

            display-name = "Base";
            sensor-bindings =
                <&inc_dec_kp C_NEXT C_PREV>,
                <&enc_vol>,
                <&inc_dec_kp C_NEXT C_PREV>,
                <&enc_vol>,
                <&inc_dec_kp C_NEXT C_PREV>,
                <&enc_vol>;
        };

        ru {
            display-name = "Ru";
            bindings = <
&kp ESC    &kp N1                   &kp N2                &kp N3              &kp N4              &kp N5                                          &kp N6              &kp N7                     &kp N8               &kp N9                 &kp N0                     &kp BACKSPACE
&kp TAB    &kp RU_CYRILLIC_SHORT_I  &kp RU_CYRILLIC_TSE   &kp RU_CYRILLIC_U   &kp RU_CYRILLIC_KA  &kp RU_CYRILLIC_IE                              &kp RU_CYRILLIC_EN  &kp RU_CYRILLIC_GHE        &kp RU_CYRILLIC_SHA  &kp RU_CYRILLIC_SHCHA  &kp RU_CYRILLIC_ZE         &kp RU_CYRILLIC_HA
&kp LSHFT  &kp RU_CYRILLIC_EF       &kp RU_CYRILLIC_YERU  &kp RU_CYRILLIC_VE  &kp RU_CYRILLIC_A   &kp RU_CYRILLIC_PE                              &kp RU_CYRILLIC_ER  &kp RU_CYRILLIC_O          &kp RU_CYRILLIC_EL   &kp RU_CYRILLIC_DE     &kp RU_CYRILLIC_ZHE        &kp RU_CYRILLIC_E
&kp LCTRL  &kp RU_CYRILLIC_YA       &kp RU_CYRILLIC_CHE   &kp RU_CYRILLIC_ES  &kp RU_CYRILLIC_EM  &kp RU_CYRILLIC_I   &kp LA(C_PP)    &kp C_MUTE  &kp RU_CYRILLIC_TE  &kp RU_CYRILLIC_SOFT_SIGN  &kp RU_CYRILLIC_BE   &kp RU_CYRILLIC_YU     &kp RU_CYRILLIC_HARD_SIGN  &kp RU_CYRILLIC_IO
                                    &kp LGUI              &kp LALT            &kp LSHIFT          &mo 2               &kp SPACE       &kp ENTER   &mo 4               &kp RSHIFT                 &kp RU_DOT           &kp RU_BACKSLASH
            >;

            sensor-bindings =
                <&inc_dec_kp C_NEXT C_PREV>,
                <&enc_vol>,
                <&inc_dec_kp C_NEXT C_PREV>,
                <&enc_vol>,
                <&inc_dec_kp C_NEXT C_PREV>,
                <&enc_vol>;
        };

        nav {
            bindings = <
&kp F1      &kp F2    &kp F3    &kp F4     &kp F5     &kp F6                     &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&kp TAB     &kp HOME  &kp UP    &kp END    &kp PG_UP  &none                      &none   &none   &none   &none    &none    &none
&kp LCTRL   &kp LEFT  &kp DOWN  &kp RIGHT  &kp PG_DN  &none                      &none   &none   &none   &none    &none    &none
&kp LSHIFT  &none     &none     &none      &none      &none   &mkp MB3    &none  &none   &none   &none   &none    &none    &none
                      &kp LGUI  &kp LALT   &none      &none   &none       &none  &mo 5   &none   &none   &none
            >;

            display-name = "Nav";
            sensor-bindings =
                <&inc_dec_kp K_SCROLL_UP K_SCROLL_DOWN>,
                <&inc_dec_kp C_BRI_UP C_BRI_DN>,
                <&inc_dec_kp K_SCROLL_UP K_SCROLL_DOWN>,
                <&inc_dec_kp C_BRI_UP C_BRI_DN>,
                <&inc_dec_kp K_SCROLL_UP K_SCROLL_DOWN>,
                <&inc_dec_kp C_BRI_UP C_BRI_DN>;
        };

        sym_en {
            bindings = <
&none  &none          &none             &none           &none                 &kp BACKSLASH                   &kp PERCENT  &none                  &none            &none              &none             &kp PRINTSCREEN
&none  &kp LESS_THAN  &kp LEFT_BRACKET  &kp LEFT_BRACE  &kp LEFT_PARENTHESIS  &kp ASTERISK                    &kp SLASH    &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACE  &kp RIGHT_BRACKET  &kp GREATER_THAN  &none
&none  &kp POUND      &kp EXCLAMATION   &kp DOT         &kp COLON             &kp UNDERSCORE                  &kp EQUAL    &kp SEMICOLON          &kp COMMA        &kp QUESTION       &kp CARET         &none
&none  &kp TILDE      &kp AMPERSAND     &kp AT_SIGN     &kp SINGLE_QUOTE      &kp PLUS        &none    &none  &kp MINUS    &kp DOUBLE_QUOTES      &kp DOLLAR       &kp PIPE           &kp GRAVE         &none
                      &none             &none           &none                 &mo 5           &none    &none  &none        &none                  &none            &none
            >;

            display-name = "Symbols";
        };

        sym_ru {
            display-name = "Symbols";
            bindings = <
&none          &none          &none               &none           &none                    &kp RU_BACKSLASH                   &kp RU_PERCENT  &none                     &none            &none              &none             &kp PRINTSCREEN
&none          &en LESS_THAN  &en LEFT_BRACKET    &en LEFT_BRACE  &kp RU_LEFT_PARENTHESIS  &kp RU_ASTERISK                    &kp RU_SLASH    &kp RU_RIGHT_PARENTHESIS  &en RIGHT_BRACE  &en RIGHT_BRACKET  &en GREATER_THAN  &none
&kp RU_NUMERO  &en POUND      &kp RU_EXCLAMATION  &kp RU_DOT      &kp RU_COLON             &kp RU_UNDERSCORE                  &kp RU_EQUAL    &kp RU_SEMICOLON          &kp RU_COMMA     &kp RU_QUESTION    &en CARET         &none
&none          &en TILDE      &en AMPERSAND       &en AT_SIGN     &en SINGLE_QUOTE         &kp RU_PLUS        &none    &none  &kp RU_MINUS    &kp RU_DOUBLE_QUOTES      &en DOLLAR       &en PIPE           &en GRAVE         &none
                              &none               &none           &none                    &mo 5              &none    &none  &none           &none                     &none            &none
            >;
        };

        adj {
            bindings = <
&bootloader  &none  &none  &none  &none  &none                  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2      &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR_ALL
&none        &none  &none  &none  &none  &none                  &none         &none         &none             &none         &none         &studio_unlock
&none        &none  &none  &none  &none  &none                  &out OUT_BLE  &kp C_VOL_DN  &kp C_MUTE        &kp C_VOL_UP  &none         &none
&none        &none  &none  &none  &none  &none  &none    &none  &out OUT_USB  &kp C_PREV    &kp C_PLAY_PAUSE  &kp C_NEXT    &none         &none
                    &none  &none  &none  &none  &none    &none  &none         &none         &none             &none
            >;

            display-name = "Adjust";
        };
    };
};
